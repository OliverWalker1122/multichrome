{
    "name": "multichrome",
    "version": "1.6.2",
    "type": "module",
    "description": "Local-first multi-profile browser manager with isolated proxies and native anti-fingerprinting",
    "main": "dist/electron/main.js",
    "scripts": {
        "postinstall": "install-electron",
        "dev": "concurrently \"npm run dev:vite\" \"npm run dev:electron\"",
        "dev:vite": "vite",
        "dev:electron": "tsc -p electron/tsconfig.json && node scripts/copy-electron-assets.mjs && cross-env NODE_ENV=development npx electron .",
        "build": "npm run build:vite && npm run build:electron",
        "build:vite": "vite build",
        "build:electron": "tsc -p electron/tsconfig.json && node scripts/copy-electron-assets.mjs",
        "start": "npx electron .",
        "package:win": "node scripts/package-win.cjs",
        "package:mac": "electron-builder --mac --publish never",
        "package:linux": "electron-builder --linux --publish never",
        "lint": "eslint . --ext .js,.ts,.tsx",
        "lint:fix": "eslint . --ext .js,.ts,.tsx --fix",
        "test": "node --test",
        "test:coverage": "node scripts/run-coverage.mjs",
        "test:e2e": "node scripts/e2e-verify.mjs",
        "test:ui": "node scripts/e2e-ui-suite.mjs",
        "audit:live": "node scripts/audit-live-sites.mjs",
        "ci": "npm run prepare:singbox && npm run lint && npm run check && npm test && npm run build",
        "prepare:singbox": "node scripts/prepare-singbox.js",
        "check": "tsc --noEmit -p tsconfig.json"
    },
    "keywords": [
        "chrome",
        "profile",
        "manager",
        "electron",
        "react"
    ],
    "author": {
        "name": "MultiChrome Contributors",
        "email": "noreply@multichrome.app"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/OliverWalker1122/multichrome.git"
    },
    "bugs": {
        "url": "https://github.com/OliverWalker1122/multichrome/issues"
    },
    "homepage": "https://github.com/OliverWalker1122/multichrome#readme",
    "license": "MIT",
    "dependencies": {
        "@fluentui/react-components": "^9.75.2",
        "@fluentui/react-icons": "^2.0.347",
        "better-sqlite3": "13.2.0",
        "dayjs": "^1.11.13",
        "electron-log": "^5.0.1",
        "electron-store": "^8.1.0",
        "koffi": "^3.3.8",
        "react": "^18.2.0",
        "react-dom": "^18.2.0",
        "uuid": "^9.0.1",
        "ws": "^8.18.3"
    },
    "devDependencies": {
        "@modelcontextprotocol/sdk": "1.32.2",
        "@playwright/mcp": "0.0.86",
        "chrome-devtools-mcp": "1.14.0",
        "@types/better-sqlite3": "^7.6.8",
        "@types/node": "^20.10.5",
        "@types/react": "^18.2.45",
        "@types/react-dom": "^18.2.18",
        "@types/uuid": "^9.0.7",
        "@types/ws": "^8.18.1",
        "@typescript-eslint/eslint-plugin": "^6.15.0",
        "@typescript-eslint/parser": "^6.15.0",
        "@vitejs/plugin-react": "^4.2.1",
        "concurrently": "^8.2.2",
        "cross-env": "^7.0.3",
        "electron": "44.11.6",
        "electron-builder": "26.18.0",
        "eslint": "^8.56.0",
        "eslint-plugin-react": "^7.33.2",
        "eslint-plugin-react-hooks": "^4.6.0",
        "typescript": "^5.3.3",
        "vite": "^5.0.10"
    },
    "build": {
        "appId": "com.multichrome.app",
        "productName": "MultiChrome",
        "directories": {
            "output": "release"
        },
        "files": [
            "dist/**/*",
            "package.json",
            "assets/icon.ico",
            "assets/icon.png"
        ],
        "win": {
            "target": [
                "nsis"
            ],
            "icon": "assets/icon.ico",
            "forceCodeSigning": false
        },
        "mac": {
            "target": [
                "dmg",
                "zip"
            ],
            "category": "public.app-category.utilities",
            "icon": "assets/icon.icns"
        },
        "linux": {
            "target": [
                "AppImage",
                "deb"
            ],
            "category": "Utility",
            "icon": "assets/icon.png"
        },
        "nsis": {
            "oneClick": false,
            "allowToChangeInstallationDirectory": true,
            "createDesktopShortcut": true
        },
        "asar": true,
        "asarUnpack": [
            "**/*.node",
            "dist/electron/transport/mcpStdioBridge.js",
            "dist/electron/domain/automationPolicy.js",
            "dist/electron/domain/mcpProtocol.js",
            "package.json"
        ],
        "npmRebuild": false
    }
}
